{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Attach KM4 (OpenOCD)",
      "cwd": "${workspaceFolder}",
      "executable": "./build/nu87-fw.elf",
      "request": "attach",
      "type": "cortex-debug",
      "servertype": "openocd",
      "configFiles": [
        "../firm-sdk/tools/openocd/nu87.cfg"
      ],
      "targetId": "rtl872xd.km4",
      "gdbPath": "arm-none-eabi-gdb",
      "showDevDebugOutput": "none",
      "breakAfterReset": false,
      "postAttachCommands": [
        "monitor targets rtl872xd.km4"
      ]
    },
    {
      "name": "Load to SRAM & Run KM4",
      "cwd": "${workspaceFolder}",
      "executable": "./build/nu87-fw.elf",
      "request": "launch",
      "type": "cortex-debug",
      "servertype": "openocd",
      "configFiles": [
        "../firm-sdk/tools/openocd/nu87.cfg"
      ],
      "targetId": "rtl872xd.km4",
      "gdbPath": "arm-none-eabi-gdb",
      "showDevDebugOutput": "none",
      "preLaunchTask": "build-build",
      "overrideLaunchCommands": [
        "monitor targets rtl872xd.km4",
        "monitor halt",
        "load",
        "monitor reg msp 0x10005000",
        "monitor nu87_run_image"
      ],
      "overrideRestartCommands": [
        "monitor halt",
        "load",
        "monitor reg msp 0x10005000",
        "monitor nu87_run_image"
      ],
      "runToEntryPoint": "main"
    },
    {
      "name": "Attach KM0 (OpenOCD)",
      "cwd": "${workspaceFolder}",
      "executable": "./build/nu87-fw.elf",
      "request": "attach",
      "type": "cortex-debug",
      "servertype": "openocd",
      "configFiles": [
        "../firm-sdk/tools/openocd/nu87.cfg"
      ],
      "targetId": "rtl872xd.km0",
      "gdbPath": "arm-none-eabi-gdb",
      "showDevDebugOutput": "none"
    }
  ]
}
